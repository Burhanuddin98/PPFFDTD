        {
            "name": "ROM mode",
            "id": "pffdtd_use_rom",
            "type": "list",
            "display": "checkbox",
            "options": {"Use cached ROM (instant)": "true"},
            "default": []
        },
        {
            "name": "Train ROM",
            "id": "pffdtd_train_rom",
            "type": "list",
            "display": "checkbox",
            "options": {"Train ROM on this run (~19 min)": "true"},
            "default": []
        }
